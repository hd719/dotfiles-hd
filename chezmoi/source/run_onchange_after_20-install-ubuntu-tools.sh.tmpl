#!/usr/bin/env bash
set -euo pipefail

{{- $repo := joinPath .chezmoi.sourceDir ".." ".." }}
# mise: {{ output "git" "-C" $repo "hash-object" "hosts/ubuntu-dev/mise.toml" | trim }}
# nvim: {{ output "git" "-C" $repo "hash-object" "config/nvim/lazy-lock.json" | trim }}
mise_bin="$HOME/.local/bin/mise"

if [[ ! -x "$mise_bin" ]]; then
  mkdir -p "$(dirname "$mise_bin")"
  curl -fsSL https://mise.run | MISE_INSTALL_PATH="$mise_bin" MISE_INSTALL_HELP=0 sh
fi

"$mise_bin" trust "$HOME/.config/mise/config.toml"
"$mise_bin" install
"$mise_bin" exec -- uv tool install --force \
  'mdformat==1.0.0' \
  --with 'mdformat-gfm==1.0.0' \
  --with 'mdformat-frontmatter==2.1.2' \
  --with 'mdformat-footnote==0.1.3' \
  --with 'mdformat-gfm-alerts==2.0.0' \
  --with 'mdformat-wikilink==0.3.0'

lazy_commit="$(
  sed -n 's/^  "lazy.nvim":.*"commit": "\([^"]*\)".*/\1/p' \
    "$HOME/.config/nvim/lazy-lock.json"
)"
lazy_dir="$HOME/.local/share/nvim/lazy/lazy.nvim"
[[ -n "$lazy_commit" ]]
if [[ ! -d "$lazy_dir/.git" ]]; then
  mkdir -p "$(dirname "$lazy_dir")"
  git clone --filter=blob:none --depth=1 --no-checkout \
    https://github.com/folke/lazy.nvim.git "$lazy_dir"
fi
if ! git -C "$lazy_dir" cat-file -e "${lazy_commit}^{commit}" 2>/dev/null; then
  git -C "$lazy_dir" fetch --depth=1 origin "$lazy_commit"
fi
git -C "$lazy_dir" checkout --detach "$lazy_commit"

DOTFILES_NVIM_RESTORE_ALL=1 \
  "$mise_bin" exec -- nvim --headless '+Lazy! restore' '+qa'
"$mise_bin" exec -- nvim --headless \
  "+lua local p = {'bash','ecma','go','gomod','gosum','gowork','graphql','javascript','json','jsx','lua','markdown','markdown_inline','python','query','toml','tsx','typescript','vim','vimdoc','yaml'}; assert(require('nvim-treesitter').install(p):wait())" \
  '+qa'
