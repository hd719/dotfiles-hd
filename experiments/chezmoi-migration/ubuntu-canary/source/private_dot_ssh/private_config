# Each service uses a VM-local private key. Never fall back to a forwarded agent.
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_hd719
  IdentitiesOnly yes
  IdentityAgent none
  StrictHostKeyChecking accept-new
  UpdateHostKeys no

Host github.com-arbiter
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_arbiter_hd
  IdentitiesOnly yes
  IdentityAgent none
  StrictHostKeyChecking accept-new
  UpdateHostKeys no

